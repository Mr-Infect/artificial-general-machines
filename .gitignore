__pycache__/
*.pyc
.pytest_cache/
.env
.venv/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
datasets/*
!datasets/.gitkeep

# results: raw run bundles, databases and memory files are tens of GB and are not tracked.
# Reports, analysis tables, plots, manifests, logs and one sample bundle per experiment are tracked.
results/*
!results/.gitkeep
!results/README.md
!results/v02_observations.txt
!results/v03_program.log
!results/v0.1_freeze/
results/v0.1_freeze/**/memory/
!results/v02/
results/v02/*
!results/v02/analysis/
!results/v02/manifests/
!results/v02/samples/
!results/v03/
results/v03/*
!results/v03/report.md
!results/v03/registration.json
!results/v03/driver_log.jsonl
!results/v03/analysis/
!results/v03/manifests/
!results/v03/plots/
!results/v03/samples/

# ARCHETYPE: raw run shards and databases are not tracked; manifests, driver logs and analysis are.
!results/archetype/
results/archetype/*/seed_*.json
results/archetype/*/*.sqlite*
results/archetype/*/driver.lock
