# Copy to .env — never commit .env.
# Database location (SQLite). Relative paths resolve against the repo root.
AGM_DB_PATH=results/agm_lab.sqlite
# Execution backend: docker (isolated container, default) or process (no container; tests only)
AGM_EXECUTOR=docker
# Sandbox image name built from sandbox/Dockerfile
AGM_SANDBOX_IMAGE=agm-lab-sandbox:0.1
# Optional API keys for future LLM-backed IR proposers. Not used in v0.1.
# ANTHROPIC_API_KEY=
